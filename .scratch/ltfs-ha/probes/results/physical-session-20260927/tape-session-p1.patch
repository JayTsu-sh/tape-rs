+        lib.load_into_drive("SESS02L8", 0).unwrap();
+        let dev = lib.drive(0);
+        mkltfs(&dev, &MkltfsOptions::default()).unwrap();
+        let key = ReservationKey::new(1, 1);
+        fence(&dev, key).unwrap();
+        let mounted = || {
+            let mut vol = LtfsVolume::mount(&dev).unwrap();
+            vol.set_reservation_guard(Some(key));
+            vol
+        };
+        assert!(
